+def session_client_id(prefix, plant, lines):
+    """Broker client id for the worker that owns `lines`.
+
+    The id names a persistent broker session (clean_session=false), so it must be:
+    - unique per worker: two connections with the same id take the session over
+      from each other, and the session's readings go to whichever is attached;
+    - stable across restarts: no pid or hostname, so a restarted (or rescheduled)
+      ingest resumes the session and receives the readings queued while it was down.
+    Deriving it from the owned lines also keeps the session's subscriptions equal
+    to what the worker stores.
+    """
+    return "%s-%s-lines-%s" % (prefix, plant, "-".join(str(l) for l in sorted(lines)))
 
 
