+def worker_client_id(prefix, index):
+    # The broker identifies a session by client id, and a second connection
+    # with the same id takes the session over (closing the first one). Every
+    # worker therefore needs its own id; it stays stable across restarts so
+    # the worker resumes its persistent session and gets what was queued.
+    return "%s-w%d" % (default_client_id(prefix), index)
