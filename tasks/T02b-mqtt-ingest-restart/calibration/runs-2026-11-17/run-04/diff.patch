+    def test_three_workers_store_all_lines_without_takeovers(self):
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        store, _ = start(settings, stop)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(1.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop.set()
+        broker.stop()
+        self.assertEqual(broker.stats["takeovers"], 0)
+        for line in (1, 2, 3):
+            sent = sum(1 for l, _, _ in pub.sent if l == line)
+            self.assertGreaterEqual(store.count(line), sent * 0.99, "line %d" % line)
+
+    def test_readings_during_restart_are_not_lost(self):
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop1 = threading.Event()
+        _, workers1 = start(settings, stop1)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(0.5)
+        # "Rolling deploy": stop the old process' workers, keep publishing, start new ones.
+        stop1.set()
+        broker.drop_all_connections(except_ids=("plant-sim-sensors",))
+        for w in workers1:
+            w.join(2)
+        time.sleep(0.5)
+        stop2 = threading.Event()
+        store, _ = start(settings, stop2)
+        time.sleep(0.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop2.set()
+        broker.stop()
+        self.assertGreaterEqual(store.count(), len(pub.sent) * 0.99)
