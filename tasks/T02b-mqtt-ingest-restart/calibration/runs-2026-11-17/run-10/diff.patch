+def default_client_id(prefix, worker=0):
+    # One stable id per ingest worker, so the broker keeps each worker's session
+    # (and queues its readings) across reconnects when clean_session is false.
+    # Ids must be unique per connection: a broker treats a second CONNECT with
+    # the same id as a session takeover and drops the older connection.
+    return "%s-%s-%d-w%d" % (prefix, socket.gethostname(), os.getpid(), worker)
 
 
