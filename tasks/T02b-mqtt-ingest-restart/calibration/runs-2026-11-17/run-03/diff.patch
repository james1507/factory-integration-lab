+def default_client_id(prefix, worker_index):
+    # A client id names exactly one broker session, and MQTT allows only one
+    # live connection per session: a second CONNECT with the same id takes the
+    # session over and the broker closes the first connection. So every worker
+    # needs its own id. The id must also be stable across process restarts
+    # (no pid), so that with clean_session=false the broker queues readings
+    # while we are down and hands them to the next process on reconnect.
+    return "%s-%s-w%d" % (prefix, socket.gethostname(), worker_index)
 
 
