+def retire_shared_session(settings, store, workers, timeout=30):
+    """Hand over from the single session that all workers shared in 2.4.0.
+
+    That session may still hold readings the broker queued while we were
+    restarting. Once every worker's own session is subscribed (so nothing new
+    can fall between the two), drain and store those readings, then delete the
+    old session so the broker stops queueing into it.
+    """
+    if not settings.clean_session:
+        deadline = time.monotonic() + timeout
+        for w in workers:
+            if not w.subscribed.wait(max(0.0, deadline - time.monotonic())):
+                log.warning("workers not subscribed after %ss; keeping shared session for next start", timeout)
+                return 0
+    cid = mqtt_client.default_client_id(settings.client_prefix)
+    stored = 0
+    c = mqtt_client.BrokerClient(settings.host, settings.port, cid, settings.keepalive, clean_session=False)
+    try:
+        if c.connect():
+            for _topic, reading in c.drain():
+                if reading.get("line") in settings.lines and store.insert(reading):
+                    stored += 1
+            log.info("retired shared session %s: stored %d queued readings", cid, stored)
+    finally:
+        c.close()
+    # A clean-session connect + disconnect deletes the old session on the broker.
+    c = mqtt_client.BrokerClient(settings.host, settings.port, cid, settings.keepalive, clean_session=True)
+    try:
+        c.connect()
+    finally:
+        c.close()
+    return stored
+
+
