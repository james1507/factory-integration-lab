+def default_client_id(prefix, worker_index):
+    # One stable id per worker connection, so the broker keeps each worker's
+    # session (and queues its readings) across reconnects when clean_session is
+    # false. The id must be unique per connection: the broker treats a CONNECT
+    # with an id that is already connected as a session takeover and closes the
+    # older connection, so workers sharing an id knock each other off.
+    return "%s-%s-%d-w%d" % (prefix, socket.gethostname(), os.getpid(), worker_index)
 
 
