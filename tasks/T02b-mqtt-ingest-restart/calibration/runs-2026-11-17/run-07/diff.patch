+def drain_legacy_session(settings, store, workers, stop_event, drain_s=LEGACY_DRAIN_S):
+    """Store readings queued under the pre-2.4.1 shared client id, then delete that session.
+
+    Up to 2.4.0 every worker used the bare process client id. The broker keeps
+    that session (subscribed to all lines) and queues readings for it while
+    ingest restarts. Once the per-worker sessions are subscribed, take it over
+    one last time, store what it delivers, and end it with a clean connect so
+    it stops queueing. Overlap with the worker sessions is de-duplicated by
+    the store.
+    """
+    for w in workers:
+        while not w.subscribed.wait(0.5):
+            if stop_event.is_set():
+                return
+    cid = mqtt_client.default_client_id(settings.client_prefix)
+    try:
+        c = mqtt_client.BrokerClient(settings.host, settings.port, cid, 1, clean_session=False)
+        present = c.connect()
+        drained = 0
+        if present:
+            deadline = time.monotonic() + drain_s
+            c._sock.settimeout(1)
+            try:
+                while time.monotonic() < deadline and not stop_event.is_set():
+                    try:
+                        msg = c._read()
+                    except OSError:  # idle for 1s: queue is flushed
+                        break
+                    if msg.get("op") == "publish":
+                        store.insert(msg["payload"])
+                        drained += 1
+            except ConnectionError:
+                pass
+        c.close()
+        # A clean-session connect discards the stored session on the broker.
+        c = mqtt_client.BrokerClient(settings.host, settings.port, cid, settings.keepalive,
+                                     clean_session=True)
+        c.connect()
+        c.close()
+        if present:
+            log.info("drained %d readings from legacy session %s and removed it", drained, cid)
+    except (OSError, ConnectionError, ValueError) as exc:
+        log.warning("could not drain legacy session %s (%s); will retry on next start", cid, exc)
 
 
