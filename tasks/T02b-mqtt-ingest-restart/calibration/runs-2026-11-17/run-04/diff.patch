+def default_client_id(prefix, worker_index):
+    # One id per worker, stable across reconnects AND process restarts, so the
+    # broker keeps each worker's session (and queues its readings) while it is
+    # away when clean_session is false.
+    # - Must differ between workers: the broker treats a CONNECT with an id that
+    #   is already connected as a session takeover and drops the other
+    #   connection, so shared ids make workers kick each other off forever.
+    # - Must not contain the pid: a new pid on restart means a new, empty
+    #   session, and readings queued during the restart are stranded.
+    return "%s-%s-w%d" % (prefix, socket.gethostname(), worker_index)
 
 
