+    def test_mes_signs_wire_bytes(self):
+        # Forgeline signs the exact bytes it sends: UTF-8, not \u-escaped, any separators.
+        for kwargs in ({"ensure_ascii": False}, {"separators": (",", ":")}):
+            e = dict(self.mes_event(), plant="VN-BD", operator="Nguyễn Văn An")
+            body = json.dumps(e, **kwargs).encode()
+            ts = str(int(time.time()))
+            sig = "sha256=" + hmac.new(MES, ts.encode() + b"." + body, hashlib.sha256).hexdigest()
+            status, _ = self.request("POST", "/webhooks/mes", body, {"X-MES-Timestamp": ts, "X-MES-Signature": sig})
+            self.assertEqual(status, 202, kwargs)
+
+    def test_mes_tampered_body_rejected(self):
+        e = self.mes_event()
+        body = json.dumps(e).encode()
+        ts = str(int(time.time()))
+        sig = "sha256=" + hmac.new(MES, ts.encode() + b"." + body, hashlib.sha256).hexdigest()
+        tampered = body.replace(b'"WO-1"', b'"WO-2"')
