+def default_client_id(prefix, worker_index):
+    # One id per worker connection: the broker treats a second CONNECT with an
+    # id that is already connected as a session takeover and closes the older
+    # connection, so workers must never share an id. The id must also stay the
+    # same across restarts (no pid), so a restarted worker reattaches to its
+    # persistent session and receives the readings queued while it was down.
+    return "%s-%s-w%d" % (prefix, socket.gethostname(), worker_index)
 
 
