+def default_client_id(prefix, worker_index=0):
+    # One stable id per ingest *connection* (process + worker), so the broker
+    # keeps each worker's session (and queues its readings) across reconnects
+    # when clean_session is false. The id must be unique per connection: the
+    # broker treats a second connect with the same id as a session takeover
+    # and closes the older connection.
+    return "%s-%s-%d-w%d" % (prefix, socket.gethostname(), os.getpid(), worker_index)
 
 
