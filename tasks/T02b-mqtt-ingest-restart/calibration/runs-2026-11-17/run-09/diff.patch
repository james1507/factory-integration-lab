+def default_client_id(prefix, plant, worker_index):
+    # One id per worker, stable across reconnects AND process restarts, so the
+    # broker keeps each worker's session (and queues its readings) while we are
+    # down when clean_session is false.
+    # - Must be unique per worker: the broker treats a CONNECT with an id that is
+    #   already connected as a session takeover and drops the older connection,
+    #   so workers sharing an id knock each other off in a loop.
+    # - Must not contain the pid: a restarted process would otherwise open a new
+    #   session and never receive the readings queued for the old one.
+    return "%s-%s-%s-w%d" % (prefix, socket.gethostname(), plant, worker_index)
 
 
