+def default_client_id(prefix, worker_index=0):
+    # One stable id per worker connection, so the broker keeps that worker's
+    # session (and queues its readings) across reconnects when clean_session is
+    # false. The id MUST be unique per connection: the broker treats a second
+    # CONNECT with the same id as a session takeover and closes the first one,
+    # and a shared session would also carry every worker's subscriptions.
+    return "%s-%s-%d-w%d" % (prefix, socket.gethostname(), os.getpid(), worker_index)
 
 
