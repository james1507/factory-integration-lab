+    def test_three_workers_store_all_lines(self):
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        store, workers = start(settings, stop)
+        self.assertEqual(len({w.client_id for w in workers}), 3, "workers must not share a session")
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(1.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop.set()
+        broker.stop()
+        self.assertEqual(broker.stats["takeovers"], 0)
+        for line in (1, 2, 3):
+            sent = sum(1 for l, _, _ in pub.sent if l == line)
+            self.assertGreaterEqual(store.count(line), sent * 0.99, "line %d" % line)
+
+    def test_readings_during_restart_are_kept(self):
+        """A restarted process must resume the same broker sessions (clean_session=false)."""
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop1 = threading.Event()
+        _, workers1 = start(settings, stop1)
+        ids1 = {w.client_id for w in workers1}
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(0.5)
+        # Simulate a restart: stop and drop connections, sessions stay at the broker.
+        stop1.set()
+        broker.drop_all_connections(except_ids=("plant-sim-sensors",))
+        for w in workers1:
+            w.join(2)
+        time.sleep(0.5)  # readings arrive while ingest is down
+        stop2 = threading.Event()
+        store2, workers2 = start(settings, stop2)
+        self.assertEqual({w.client_id for w in workers2}, ids1)
+        time.sleep(0.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop2.set()
+        broker.stop()
+        self.assertGreaterEqual(store2.count(), len(pub.sent) * 0.99)
