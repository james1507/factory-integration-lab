+def worker_client_id(prefix, worker_index):
+    """Client id for one ingest worker.
+
+    The broker identifies a session by client id, and a CONNECT with an id that
+    is already connected takes that session over (MQTT-3.1.4-2). So:
+    - every worker needs its own id, or the workers keep kicking each other off
+      one shared session and readings are delivered to the wrong worker;
+    - the id must be the same after a restart (no pid), or the persistent
+      session holding the readings queued during the restart is never resumed.
+    """
+    return "%s-%s-w%d" % (prefix, socket.gethostname(), worker_index)
 
 
