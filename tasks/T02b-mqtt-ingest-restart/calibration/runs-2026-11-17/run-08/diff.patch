+    def test_three_workers_store_all_lines(self):
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        store, workers = start(settings, stop)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(1.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop.set()
+        broker.stop()
+        self.assertEqual(len({w.client_id for w in workers}), 3)
+        self.assertEqual(broker.stats["takeovers"], 0)
+        for line in (1, 2, 3):
+            sent = sum(1 for l, _, _ in pub.sent if l == line)
+            self.assertGreaterEqual(store.count(line), sent * 0.99, "line %d" % line)
+
+    def test_no_loss_across_restart(self):
+        """Readings published while ingest is down are delivered after it restarts."""
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        _, workers = start(settings, stop)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(0.5)
+        stop.set()
+        broker.drop_all_connections(except_ids=("plant-sim-sensors",))
+        for w in workers:
+            w.join(2)
+        time.sleep(0.5)  # ingest is down; broker must queue
+        stop = threading.Event()
+        store, _ = start(settings, stop)  # same process, same ids as a restart
+        time.sleep(0.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop.set()
+        broker.stop()
+        self.assertEqual(store.count(), len(pub.sent))
