+    def test_three_workers_store_all_lines_without_takeovers(self):
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        store, workers = start(settings, stop)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(1.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop.set()
+        broker.stop()
+        self.assertEqual(len({w.client_id for w in workers}), 3)
+        self.assertEqual(broker.stats["takeovers"], 0)
+        for line in (1, 2, 3):
+            sent = sum(1 for l, _, _ in pub.sent if l == line)
+            self.assertGreaterEqual(store.count(line), sent * 0.99, "line %d" % line)
+
+    def test_restart_keeps_readings_published_while_down(self):
+        """Persistent sessions: readings sent while ingest is down are delivered after restart."""
+        broker = Broker().start()
+        tmp = tempfile.mkdtemp()
+        settings = Settings(write_ini(tmp, broker.port, workers=3))
+        stop = threading.Event()
+        store, workers = start(settings, stop)
+        time.sleep(0.3)
+        pub = Publisher(broker.port, rate=50)
+        pub.start()
+        time.sleep(0.5)
+        stop.set()
+        for w in workers:
+            w.client.close()
+            w.join(2)
+        time.sleep(0.5)  # readings published now must be queued by the broker
+        stop2 = threading.Event()
+        store2, _ = start(settings, stop2)
+        time.sleep(0.5)
+        pub.stop()
+        time.sleep(0.5)
+        stop2.set()
+        broker.stop()
+        self.assertGreaterEqual(store2.count(), len(pub.sent) * 0.99)
