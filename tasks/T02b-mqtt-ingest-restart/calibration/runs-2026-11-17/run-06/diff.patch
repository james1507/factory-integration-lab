+def worker_client_id(prefix, index):
+    # A client id identifies exactly one broker session, and a second CONNECT
+    # with the same id takes the session over and drops the first connection.
+    # Each worker therefore needs its own id; it must still be stable across
+    # restarts so its persistent session (and the readings queued in it while
+    # we were down) is picked up again.
+    return "%s-w%d" % (default_client_id(prefix), index)
